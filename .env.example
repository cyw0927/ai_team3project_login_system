# ============================================================
# AX 평가 시스템 환경변수 예시
# 실제 값은 .env에 입력하고 .env는 Git에 올리지 않습니다.
# ============================================================

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (교육과정 기본)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=여기에_PostgreSQL_비밀번호
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SCHEMA=practice

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
