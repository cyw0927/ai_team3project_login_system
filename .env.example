# ============================================================
# AX 평가 시스템 환경변수 예시
# 실제 값은 .env에 입력하고 .env는 Git에 올리지 않습니다.
# ============================================================

# Django
# 반드시 실제 랜덤 키로 교체하세요. 값이 없으면 애플리케이션이 시작되지 않습니다.
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
# 개발 환경에서만 True. 기본값은 False입니다.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 개발용 Cloudflare Quick Tunnel을 사용할 때만 1로 설정합니다.
DJANGO_DEV_TUNNEL=0
# 실제 운영이 신뢰할 수 있는 HTTPS reverse proxy 뒤에 있을 때만 1로 설정합니다.
DJANGO_TRUST_X_FORWARDED_PROTO=0
# 필요하면 쉼표로 구분해 명시적인 origin만 추가합니다.
DJANGO_CSRF_TRUSTED_ORIGINS=

# 운영 보안 설정. DEBUG=False일 때 기본값은 안전한 쪽(True/1년 HSTS)입니다.
# 로컬 HTTP 개발/CI에서만 필요 시 명시적으로 0으로 끌 수 있습니다.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# PostgreSQL (교육과정 기본)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=여기에_PostgreSQL_비밀번호
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SCHEMA=practice

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
